# rak's keys and defaults. Fill in the ones you use; leave the rest empty.
#
# rak reads the environment first, then .env in the project folder, then
# ~/.config/rak/.env (`rak keys` creates that file from this template and shows
# what is set). Values from these files stay inside rak: commands the agent
# runs do not see them.

# Claude through Anthropic's own API, with prompt caching.
# With this set, a claude-* model (rak -m claude-opus-5-5) uses Anthropic's API.
ANTHROPIC_API_KEY=

# A server that speaks OpenAI's chat-completions API and needs a key:
# OpenAI, OpenRouter, Hugging Face's router… (Ollama on this machine needs none.)
# RAK_API_KEY is tried first, then OPENAI_API_KEY.
RAK_API_KEY=
OPENAI_API_KEY=

# web_search, through Tavily (https://tavily.com). Without it, rak has no web search.
TAVILY_API_KEY=

# Defaults, so you don't have to pass them each time (optional).
# RAK_MODEL=kimi-k2.6:cloud
# RAK_PROVIDER=openai          # openai or anthropic
# RAK_BASE_URL=http://localhost:11434/v1
