# rak's keys and defaults.
#
# rak reads the environment first, then .env in the project folder, then
# ~/.config/rak/.env (`rak keys` creates that file from this template and shows
# what is set). Values from these files stay inside rak: commands the agent
# runs do not see them. Lines starting with # are ignored.
#
# Two steps:
#   1. Put in the keys of the providers you use (section 1).
#   2. Pick your default provider and model (section 2): uncomment ONE block.
#
# Any other provider, for one run:   rak --provider NAME -m MODEL
# Its key comes from section 1. `rak keys` lists every provider and its key.


# ─── 1. Keys: one per provider ──────────────────────────────────────────────
# Each provider only ever gets its own key. Leave the ones you don't use empty.

ANTHROPIC_API_KEY=       # anthropic       Claude, Anthropic's API
OPENAI_API_KEY=          # openai          OpenAI
OLLAMA_API_KEY=          # ollama-cloud    Ollama's cloud at ollama.com (keys: ollama.com/settings/keys)
OPENROUTER_API_KEY=      # openrouter      OpenRouter
HF_TOKEN=                # huggingface     Hugging Face's router
GROQ_API_KEY=            # groq            Groq
DEEPSEEK_API_KEY=        # deepseek        DeepSeek
MISTRAL_API_KEY=         # mistral         Mistral
GEMINI_API_KEY=          # gemini          Google Gemini
ZAI_API_KEY=             # zai, zai-coding Z.ai (GLM); zai-coding is for GLM Coding Plan keys

# web_search, through Tavily (https://tavily.com). Without it, rak has no web search.
TAVILY_API_KEY=


# ─── 2. Default provider and model: uncomment ONE block ─────────────────────
# With none, rak uses Ollama on this machine (and Anthropic for a claude-*
# model when ANTHROPIC_API_KEY is set).
#
# RAK_MODEL is the model as that provider names it. Leave it empty and rak
# lists the provider's models to pick from; in a chat, /models lists them and
# /model NAME switches.

# Ollama on this machine. No key. Its :cloud models run on ollama.com once
# you have run `ollama signin`.
# RAK_PROVIDER=ollama
# RAK_MODEL=kimi-k2.6:cloud

# Ollama's cloud directly, without Ollama installed. Key: OLLAMA_API_KEY.
# RAK_PROVIDER=ollama-cloud
# RAK_MODEL=

# Claude through Anthropic's API (with prompt caching). Key: ANTHROPIC_API_KEY.
# RAK_PROVIDER=anthropic
# RAK_MODEL=claude-sonnet-5-5

# OpenAI. Key: OPENAI_API_KEY.
# RAK_PROVIDER=openai
# RAK_MODEL=

# OpenRouter: many vendors' models with one key; names look like vendor/model.
# Key: OPENROUTER_API_KEY.
# RAK_PROVIDER=openrouter
# RAK_MODEL=

# Hugging Face's router. Key: HF_TOKEN (with "Make calls to Inference Providers").
# RAK_PROVIDER=huggingface
# RAK_MODEL=

# Groq. Key: GROQ_API_KEY.
# RAK_PROVIDER=groq
# RAK_MODEL=

# DeepSeek. Key: DEEPSEEK_API_KEY.
# RAK_PROVIDER=deepseek
# RAK_MODEL=

# Mistral. Key: MISTRAL_API_KEY.
# RAK_PROVIDER=mistral
# RAK_MODEL=

# Google Gemini. Key: GEMINI_API_KEY.
# RAK_PROVIDER=gemini
# RAK_MODEL=

# Z.ai (GLM). Key: ZAI_API_KEY.
# RAK_PROVIDER=zai
# RAK_MODEL=glm-5.2

# Z.ai with a GLM Coding Plan key. Key: ZAI_API_KEY.
# RAK_PROVIDER=zai-coding
# RAK_MODEL=glm-5.2

# Servers on this machine, no key: LM Studio, llama.cpp's llama-server, vLLM.
# RAK_PROVIDER=lmstudio
# RAK_PROVIDER=llamacpp
# RAK_PROVIDER=vllm
# RAK_MODEL=


# ─── 3. Less common ─────────────────────────────────────────────────────────

# A provider at an address other than its usual one (another machine running
# Ollama, say). Goes with RAK_PROVIDER above.
# RAK_BASE_URL=http://gpu-box:11434/v1

# A server rak doesn't know by name, for one run:
#   rak --base-url https://example.com/v1 -m MODEL
# It gets RAK_API_KEY below, or the key you name with --api-key-env NAME.
RAK_API_KEY=
