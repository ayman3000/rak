# rak's keys and settings.
#
# rak reads the environment first, then .env in the project folder, then
# ~/.config/rak/.env (`rak keys` creates that file from this template, and
# `rak keys --update` brings an older one up to date). Values from these files
# stay inside rak: commands the agent runs do not see them. Lines starting
# with # are ignored. Put each value right after its "=", with no quotes.
#
# `rak keys` shows which keys are set (never the keys themselves).


# ─── 1. API keys: one per provider ──────────────────────────────────────────
# Each provider only ever gets its own key. Fill in the ones you have.

OPENAI_API_KEY=          # openai          OpenAI
GEMINI_API_KEY=          # gemini          Google Gemini
ANTHROPIC_API_KEY=       # anthropic       Claude, Anthropic's API
ZAI_API_KEY=             # zai, zai-coding Z.ai (GLM); zai-coding for GLM Coding Plan keys
OLLAMA_API_KEY=          # ollama-cloud    Ollama's cloud at ollama.com (keys: ollama.com/settings/keys)
OPENROUTER_API_KEY=      # openrouter      OpenRouter

# More providers
HF_TOKEN=                # huggingface     Hugging Face's router
GROQ_API_KEY=            # groq            Groq
DEEPSEEK_API_KEY=        # deepseek        DeepSeek
MISTRAL_API_KEY=         # mistral         Mistral

# web_search, through Tavily (https://tavily.com). Without it, rak has no web search.
TAVILY_API_KEY=


# ─── 2. Selected provider and model ─────────────────────────────────────────
# What rak uses when you just type `rak`.
#
# RAK_PROVIDER is one of:
#   openai, gemini, anthropic, zai, zai-coding, ollama-cloud, openrouter,
#   huggingface, groq, deepseek, mistral,
#   ollama (Ollama on this machine, no key; its :cloud models need `ollama signin`),
#   lmstudio, llamacpp, vllm (servers on this machine, no key)
# Empty: Ollama on this machine (or Anthropic for a claude-* model when its key is set).
RAK_PROVIDER=

# RAK_MODEL is the model as that provider names it, for example
#   ollama: kimi-k2.6:cloud    anthropic: claude-sonnet-5-5    zai: glm-5.2
# Empty: rak lists the provider's models to pick from when a chat starts.
# In a chat, /provider NAME and /model NAME switch, and rak remembers your last
# model for each provider.
RAK_MODEL=


# ─── 3. Less common ─────────────────────────────────────────────────────────

# The selected provider at an address other than its usual one (another
# machine running Ollama, say).
RAK_BASE_URL=

# A server rak doesn't know by name, for one run:
#   rak --base-url https://example.com/v1 -m MODEL
# It gets this key, or the one you name with --api-key-env NAME.
RAK_API_KEY=
